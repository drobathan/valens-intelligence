# ─── Clerk Authentication ───────────────────────────────────────────────────
# Get these from: https://dashboard.clerk.com → Your App → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=YOUR_CLERK_SECRET_KEY_HERE

# Clerk redirect URLs (leave as-is)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ─── Notion Integration ─────────────────────────────────────────────────────
# Get this from: https://www.notion.so/my-integrations → Your Integration → Internal Integration Secret
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Page / Database IDs for TMO Highways (or whichever client this instance serves)
# Find IDs in the Notion URL: notion.so/{workspace}/{PAGE_ID}
NOTION_GSI_PAGE_ID=3278480d505b816a8568cb91f2de00c8
NOTION_DECISIONS_DB_ID=3278480d505b81c1bb2edaf2bd765fc7
NOTION_ACTIONS_DB_ID=3278480d505b81f7b957c4873cdca364
NOTION_ASSESSMENT_HISTORY_DB_ID=3278480d505b81b9a2f2000b5ea3f1c9

# ─── Client Config ──────────────────────────────────────────────────────────
# One of: PE | SPORTS | TECH  (controls label terminology across the dashboard)
CLIENT_TYPE=PE

# Client display name shown in the header
CLIENT_NAME=TMO Highways

# Engagement reference code
ENGAGEMENT_ID=TTC-001

# Engagement lead name
ENGAGEMENT_LEAD=Daniel Robathan
